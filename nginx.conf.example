# Double Pi-hole dashboard: optional HTTPS front proxy (nginx http context).
# The dashboard itself runs on 127.0.0.1:8080 through Docker Compose or the
# generated configuration from tools/render_config.py --listen-address 127.0.0.1.
# Adjust dns.example.com and the certificate/key paths below.
#
# Configure every Pi-hole once in the private config.json. The renderer generates
# its fingerprinted API routes and public browser configuration. Do not add
# separate /api1.../api4 upstream definitions here. See docs/CONFIGURATION.md.
#
# Keep proxy_pass without a URI suffix or rewrite so encoded paths and queries
# reach the generated proxy unchanged. Disabled buffering supports Gravity output.
# Apply any access controls to this front proxy and keep port 8080 on loopback.
# The generated server provides CSP/security headers; its embedded application
# scripts require script-src 'unsafe-inline'. Upstream Pi-hole certificate
# verification is configured separately with verifyTls in the canonical JSON.

server {
    listen 443 ssl;
    server_name dns.example.com;

    ssl_certificate     /etc/nginx/ssl/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dns.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name dns.example.com;
    return 301 https://$host$request_uri;
}
