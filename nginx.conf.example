# ------------------------------------------------------------------
# Double Pi-hole dashboard — nginx reverse proxy example
#
# Values to adjust:
#   dns.example.com         -> domain name used to access this dashboard
#   pihole1.example.com     -> host name or IP address of your first Pi-hole instance
#   pihole2.example.com     -> host name or IP address of your second Pi-hole instance
#   pihole3.example.com     -> third Pi-hole, if DEFAULT_SERVER_COUNT is 3 or 4
#   pihole4.example.com     -> fourth Pi-hole, if DEFAULT_SERVER_COUNT is 4
#   /etc/nginx/ssl/...      -> your SSL certificate and private key
#   /srv/web/dobbeltpihole  -> location of index.html and chart.umd.min.js
#
# Why this proxy is required: The dashboard JavaScript fetches data from
# /api1/... through /api4/... as relative paths on the same host. nginx then
# forwards these requests to the corresponding Pi-hole instances, avoiding CORS
# entirely. Set DEFAULT_SERVER_COUNT only in index.html (2, 3 or 4).
# The first two proxies are enabled; uncomment the additional blocks as needed.
# Pi-hole's CORS handling is not consistent across all endpoints.
# This is therefore the simplest way to achieve a stable setup.
# ------------------------------------------------------------------

server {
    listen 443 ssl http2;
    server_name dns.example.com;

    ssl_certificate     /etc/nginx/ssl/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dns.example.com/privkey.pem;

    root /srv/web/dobbeltpihole;
    index index.html;
    autoindex off;

    # --- Basic security headers ---------------------------------------
    # Note about script-src 'unsafe-inline': The dashboard is provided as
    # one self-contained HTML file with JavaScript embedded directly in it.
    # The browser must therefore be allowed to execute inline JavaScript.
    # This means that this CSP does not block an injected inline <script> if
    # one were to pass through the application's escaping. The policy mainly
    # restricts which sources may be contacted, embedded or loaded.
    #
    # If the dashboard is shared with other people rather than used only by
    # you, the <script> block can be moved to a separate app.js file. You can
    # then remove 'unsafe-inline' from script-src to close this gap.
    # For personal use, the risk is limited because only you can be affected.
    #
    # When hosting the dashboard on a Synology NAS, you can also create and
    # assign an Access Control Profile in DSM. The profile can restrict access
    # to selected IP addresses or local networks, preventing unauthorized
    # access to the dashboard.

    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self';" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "same-origin" always;

    # --- Reverse proxy to 2–4 Pi-hole instances ------------------
    location /api1/ {
        proxy_pass https://pihole1.example.com/api/;
        proxy_ssl_verify off;              # Remove if pihole1 has a public, trusted certificate
        proxy_set_header Host pihole1.example.com;
        proxy_ssl_server_name on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    location /api2/ {
        proxy_pass https://pihole2.example.com/api/;
        proxy_ssl_verify off;              # Remove if pihole2 has a public, trusted certificate
        proxy_set_header Host pihole2.example.com;
        proxy_ssl_server_name on;
        proxy_connect_timeout 10s;
        proxy_read_timeout 30s;
    }

    # Optional Pi-hole 3: uncomment the entire block and adjust the address.
    # location /api3/ {
    #     proxy_pass https://pihole3.example.com/api/;
    #     proxy_ssl_verify off;              # Remove if pihole3 has a public, trusted certificate
    #     proxy_set_header Host pihole3.example.com;
    #     proxy_ssl_server_name on;
    #     proxy_connect_timeout 10s;
    #     proxy_read_timeout 30s;
    # }

    # Optional Pi-hole 4: uncomment the entire block and adjust the address.
    # location /api4/ {
    #     proxy_pass https://pihole4.example.com/api/;
    #     proxy_ssl_verify off;              # Remove if pihole4 has a public, trusted certificate
    #     proxy_set_header Host pihole4.example.com;
    #     proxy_ssl_server_name on;
    #     proxy_connect_timeout 10s;
    #     proxy_read_timeout 30s;
    # }

    # --- Dashboard files ---------------------------------------------
    location / {
        try_files $uri $uri/ =404;
    }

    location ~ /\. {
        deny all;
    }
}

# Optional: Redirect HTTP to HTTPS
server {
    listen 80;
    server_name dns.example.com;
    return 301 https://$host$request_uri;
}
