# Double Pi-hole dashboard: optional HTTPS front proxy (nginx http context).
# The target below suits Docker Compose or a generated local backend listening
# on 127.0.0.1:8080. Adjust dns.example.com and the certificate/key paths.
# For a native LXC on another machine, change only the proxy_pass host to the
# CT's IP address, e.g. http://192.168.1.50:8080, and restrict access to the CT
# backend port using your existing firewall. See docs/LXC.md.
#
# Configure each Pi-hole once in the private config.json. The renderer generates
# fingerprinted API routes and public browser configuration. Do not add separate
# /api1.../api4 upstream definitions here. See docs/CONFIGURATION.md.
#
# Keep proxy_pass without a URI suffix or rewrite to preserve encoded paths and
# queries. Disabled buffering supports streamed Gravity output. Apply access
# controls to this front proxy and prevent unintended direct backend access.
# The generated server supplies CSP hashes and security headers; regenerate its
# configuration after changing embedded scripts. It strips browser Authorization
# and Cookie headers before forwarding to Pi-hole. Upstream certificate checks
# are configured separately with verifyTls in the canonical JSON.

server {
    listen 443 ssl;
    server_name dns.example.com;

    ssl_certificate     /etc/nginx/ssl/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dns.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name dns.example.com;
    return 301 https://$host$request_uri;
}
