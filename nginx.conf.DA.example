# Dobbelt Pi-hole-kontrolpanel: valgfri HTTPS-proxy (i nginx' http-kontekst).
# Selve kontrolpanelet kører på 127.0.0.1:8080 via Docker Compose eller en
# konfiguration dannet med tools/render_config.py --listen-address 127.0.0.1.
# Tilpas dns.example.com og stierne til certifikatet og den private nøgle.
#
# Angiv hver Pi-hole én gang i den private config.json. Værktøjet danner de
# tilhørende API-stier med fingeraftryk samt browserens offentlige konfiguration.
# Tilføj ikke separate /api1.../api4-proxyer her. Se docs/CONFIGURATION.md.
#
# Behold proxy_pass uden URI-suffiks eller omskrivning, så kodede stier og query-
# parametre når frem uændret. Deaktiveret buffering understøtter Gravity-output.
# Læg eventuel adgangskontrol på denne proxy, og bind port 8080 til loopback.
# Den genererede server leverer CSP og sikkerhedsheadere; de indlejrede scripts
# kræver script-src 'unsafe-inline'. Certifikatkontrol ved forbindelse til
# Pi-hole angives separat med verifyTls i den centrale JSON-fil.

server {
    listen 443 ssl;
    server_name dns.example.com;

    ssl_certificate     /etc/nginx/ssl/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dns.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name dns.example.com;
    return 301 https://$host$request_uri;
}
