# Dobbelt Pi-hole-kontrolpanel: valgfri HTTPS-proxy (i nginx' http-kontekst).
# Målet nedenfor passer til Docker Compose eller en lokal backend, der lytter
# på 127.0.0.1:8080. Tilpas dns.example.com og certifikat-/nøglestierne.
# Kører en native LXC på en anden maskine, ændres kun proxy_pass-værten til
# CT'ens IP-adresse, f.eks. http://192.168.1.50:8080. Begræns adgangen til
# backendporten med den eksisterende firewall. Se docs/LXC.md.
#
# Angiv hver Pi-hole én gang i den private config.json. Værktøjet danner
# API-stier med fingeraftryk samt browserens offentlige konfiguration.
# Tilføj ikke separate /api1.../api4-proxyer her. Se docs/CONFIGURATION.md.
#
# Behold proxy_pass uden URI-suffiks eller omskrivning, så kodede stier og
# query-parametre bevares. Deaktiveret buffering understøtter Gravity-output.
# Læg adgangskontrol på denne proxy, og begræns utilsigtet direkte backendadgang.
# Den genererede server leverer CSP-hashværdier og sikkerhedsheadere; dan dens
# konfiguration igen efter scriptændringer. Browserens Authorization- og Cookie-
# headere fjernes før videresendelse til Pi-hole. Certifikatkontrol ved forbindelse
# til Pi-hole angives separat med verifyTls i den centrale JSON-fil.

server {
    listen 443 ssl;
    server_name dns.example.com;

    ssl_certificate     /etc/nginx/ssl/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dns.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name dns.example.com;
    return 301 https://$host$request_uri;
}
