# Doppel-Pi-hole-Dashboard: optionaler HTTPS-Proxy (im nginx-http-Kontext).
# Das Dashboard läuft auf 127.0.0.1:8080 über Docker Compose oder eine mit
# tools/render_config.py --listen-address 127.0.0.1 erzeugte Konfiguration.
# Passe dns.example.com und die Pfade zu Zertifikat und privatem Schlüssel an.
#
# Trage jede Pi-hole-Instanz einmal in die private config.json ein. Der Generator
# erzeugt die API-Routen mit Fingerabdruck und die öffentliche Browserkonfiguration.
# Ergänze hier keine separaten /api1.../api4-Ziele. Siehe docs/CONFIGURATION.md.
#
# Belasse proxy_pass ohne URI-Suffix oder Umschreibung, damit kodierte Pfade und
# Abfrageparameter unverändert ankommen. Ohne Pufferung erscheint Gravity-Ausgabe
# fortlaufend. Richte Zugriffskontrollen an diesem Proxy ein; Port 8080 bleibt
# an Loopback gebunden. Der erzeugte Server liefert CSP und Sicherheitsheader;
# seine eingebetteten Skripte erfordern script-src 'unsafe-inline'. Die Prüfung
# der Pi-hole-Zertifikate wird separat über verifyTls in der JSON-Datei festgelegt.

server {
    listen 443 ssl;
    server_name dns.example.com;

    ssl_certificate     /etc/nginx/ssl/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dns.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name dns.example.com;
    return 301 https://$host$request_uri;
}
