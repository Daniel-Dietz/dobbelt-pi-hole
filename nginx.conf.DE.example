# Doppel-Pi-hole-Dashboard: optionaler HTTPS-Proxy (im nginx-http-Kontext).
# Das folgende Ziel passt zu Docker Compose oder einem lokalen Backend auf
# 127.0.0.1:8080. Passe dns.example.com sowie Zertifikat- und Schlüsselpfade an.
# Läuft ein nativer LXC auf einer anderen Maschine, ändere nur den proxy_pass-
# Host auf dessen IP, z.B. http://192.168.1.50:8080. Beschränke den Zugriff auf
# den CT-Backendport mit der vorhandenen Firewall. Siehe docs/LXC.md.
#
# Trage jede Pi-hole-Instanz einmal in die private config.json ein. Der Generator
# erzeugt API-Routen mit Fingerabdruck und die öffentliche Browserkonfiguration.
# Ergänze hier keine separaten /api1.../api4-Ziele. Siehe docs/CONFIGURATION.md.
#
# Belasse proxy_pass ohne URI-Suffix oder Umschreibung, damit kodierte Pfade und
# Abfrageparameter erhalten bleiben. Ohne Pufferung erscheint Gravity-Ausgabe
# fortlaufend. Richte Zugriffskontrollen an diesem Proxy ein und beschränke
# unbeabsichtigten direkten Backendzugriff. Der erzeugte Server liefert CSP-Hashes
# und Sicherheitsheader; erzeuge seine Konfiguration nach Skriptänderungen neu.
# Authorization- und Cookie-Header des Browsers werden vor der Weiterleitung an
# Pi-hole entfernt. Die Zertifikatsprüfung wird separat über verifyTls festgelegt.

server {
    listen 443 ssl;
    server_name dns.example.com;

    ssl_certificate     /etc/nginx/ssl/dns.example.com/fullchain.pem;
    ssl_certificate_key /etc/nginx/ssl/dns.example.com/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_connect_timeout 10s;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name dns.example.com;
    return 301 https://$host$request_uri;
}
