# A disposable Debian 13 guest for the native installer integration test.
# nginx is deliberately absent: the actual guest installer must install it.
# This supplies systemd and test prerequisites; it is not the production image
# and does not reproduce Proxmox storage, AppArmor or unprivileged LXC ID mapping.
FROM debian:13-slim

# Let systemd select its container behavior when /sbin/init runs as PID 1.
ENV container=docker

# Include inspection tools needed by the fixture harness. Reset machine identity
# so each disposable guest can initialize its own systemd/dbus identity at boot.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --no-install-recommends --yes \
        ca-certificates curl dbus iproute2 procps python3 systemd systemd-sysv util-linux \
    && rm -rf /var/lib/apt/lists/* \
    && truncate --size=0 /etc/machine-id \
    && rm -f /var/lib/dbus/machine-id \
    && ln -s /etc/machine-id /var/lib/dbus/machine-id

# Drop only Debian's Docker service-start blocker after the build-time installs.
# The real guest installation must rely on its own nginx service mask instead.
RUN if [ -e /usr/sbin/policy-rc.d ] || [ -L /usr/sbin/policy-rc.d ]; then \
        { [ -f /usr/sbin/policy-rc.d ] && [ ! -L /usr/sbin/policy-rc.d ] \
          && [ "$(sed '/^[[:space:]]*#/d; /^[[:space:]]*$/d' /usr/sbin/policy-rc.d)" = 'exit 101' ]; } \
          || { echo 'Refusing to remove an unexpected package service policy' >&2; exit 1; }; \
        rm -- /usr/sbin/policy-rc.d; \
    fi

# The test uses its own cgroup namespace and tmpfs; never bind the host cgroups.
# systemd's container interface defines SIGRTMIN+3 as an orderly shutdown.
STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init", "--log-target=console"]
